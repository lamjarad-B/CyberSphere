# Copie à renommer en .env.production puis à passer à docker compose :
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build

# --- Reverse proxy (service caddy) ---
# Domaine public du site : Caddy obtient et renouvelle le certificat TLS seul
SITE_DOMAIN="cybersphere.example.com"

# --- Base de données (service db) ---
POSTGRES_USER="cybersphere"
POSTGRES_PASSWORD="CHANGEZ_MOI_mot_de_passe_fort"
POSTGRES_DB="cybersphere"

# --- Application ---
# URL publique réelle du site (figée au build pour NEXT_PUBLIC_*)
NEXT_PUBLIC_APP_URL="https://cybersphere.example.com"
# Générez un secret : openssl rand -hex 32
BETTER_AUTH_SECRET="CHANGEZ_MOI"
# Contact affiché dans /.well-known/security.txt et /securite
SECURITY_CONTACT="securite@example.com"

# --- CAPTCHA Cloudflare Turnstile (recommandé en production) ---
# Créez un widget sur https://dash.cloudflare.com → Turnstile.
# Laissez vide pour désactiver le CAPTCHA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Sauvegardes chiffrées (service backup) ---
# Passphrase AES-256 des dumps quotidiens — à conserver hors du serveur !
BACKUP_PASSPHRASE="CHANGEZ_MOI_passphrase_forte"
BACKUP_KEEP_DAYS="14"

# --- API Claude (Anthropic) : pré-traduction IA des articles ---
# Vide = bouton « Pré-traduire avec l'IA » désactivé dans l'admin.
ANTHROPIC_API_KEY=""

# --- SMTP (vérification d'e-mail, réinitialisation, newsletter) ---
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="postmaster@example.com"
SMTP_PASS="CHANGEZ_MOI"
SMTP_FROM="CyberSphere <no-reply@example.com>"
