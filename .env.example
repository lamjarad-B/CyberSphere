# Base de données PostgreSQL (POSTGRES_PASSWORD est utilisé par docker-compose.yml)
POSTGRES_PASSWORD="CHANGEZ_MOI"
DATABASE_URL="postgresql://cybersphere:CHANGEZ_MOI@localhost:5433/cybersphere"

# better-auth — générez un secret : openssl rand -hex 32
BETTER_AUTH_SECRET="CHANGEZ_MOI"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Compte administrateur créé par le seed (prisma/seed.ts)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="CHANGEZ_MOI"
ADMIN_NAME="Admin"

# SMTP pour l'envoi des e-mails de vérification de compte.
# Laissez SMTP_HOST vide en dev : le lien de vérification s'affiche dans la console.
# En production, renseignez un fournisseur (Mailgun, SendGrid, OVH, Gmail…).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="CyberSphere <no-reply@example.com>"
