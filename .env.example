# Base de données PostgreSQL (POSTGRES_PASSWORD est utilisé par docker-compose.yml)
POSTGRES_PASSWORD="CHANGEZ_MOI"
DATABASE_URL="postgresql://cybersphere:CHANGEZ_MOI@localhost:5433/cybersphere"

# better-auth — générez un secret : openssl rand -hex 32
# L'URL doit correspondre au port réel du serveur de dev (fixé à 3001
# dans le script `dev`) : une origine différente fait échouer la connexion.
BETTER_AUTH_SECRET="CHANGEZ_MOI"
BETTER_AUTH_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Compte administrateur créé par le seed (prisma/seed.ts)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="CHANGEZ_MOI"
ADMIN_NAME="Admin"

# Contact affiché dans /.well-known/security.txt et /securite (facultatif)
SECURITY_CONTACT=""

# CAPTCHA Cloudflare Turnstile — laissez vide pour le désactiver (dev).
# Clés de test Cloudflare (widget toujours validé) :
#   site   : 1x00000000000000000000AA
#   secret : 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# SMTP pour l'envoi des e-mails de vérification de compte.
# Laissez SMTP_HOST vide en dev : le lien de vérification s'affiche dans la console.
# En production, renseignez un fournisseur (Mailgun, SendGrid, OVH, Gmail…).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="CyberSphere <no-reply@example.com>"

# API Claude (Anthropic) pour la pré-traduction IA des articles dans
# le formulaire admin. Vide = bouton désactivé.
# Clé à créer sur https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
